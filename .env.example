# Environment Configuration
# Copy this file to .env and fill in all required values

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_secret
POSTGRES_DB=reachinbox
DATABASE_URL="postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Session & Security ───────────────────────────────────────────────────────
SESSION_SECRET=your-super-secret-session-key-change-in-production-min-32-chars
ENCRYPTION_KEY=your-32-char-encryption-key-here!!   # Exactly 32 characters

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ─── Ethereal SMTP ────────────────────────────────────────────────────────────
# Leave empty to auto-generate a new Ethereal test account on startup
# Or set these to re-use an existing Ethereal account
ETHEREAL_USER=
ETHEREAL_PASS=

# ─── Slack OAuth ──────────────────────────────────────────────────────────────
# Create at: https://api.slack.com/apps
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=http://localhost:4000/api/v1/integrations/slack/callback

# ─── Worker Configuration ─────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ─── Upload Limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5
MAX_RECIPIENTS_PER_SCHEDULE=10000

# ─── Bull Board ───────────────────────────────────────────────────────────────
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin-password-change-me

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
